migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Cloudflare Wrangler local state + build artifacts (deploy-only, not source)
/.wrangler/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Stray nested clone
/kra/

# Local secrets + wrangler state. Both branches added these independently after
# they went missing from the ignore list, which left .env / .dev.vars files
# untracked-but-not-ignored — one `git add -A` away from committing credentials.
# The negations keep the checked-in examples visible.
#
# `.wrangler` is broader than the `/.wrangler/` rule above (it matches at any
# depth); both are kept so neither branch loses coverage.
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Kotlin incremental-compile session files (build artifacts, not source).
android/.kotlin/
